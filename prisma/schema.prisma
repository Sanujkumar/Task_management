generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            Int            @id @default(autoincrement())
  email                         String         @unique
  password                      String
  name                          String?
  phone                         String?
  image                         String?   
  notificaion                   Notification[]  
  assignedTasks                 Task[]         @relation("AssignedTasks")
  tasks                         Task[]         @relation("CreatedTasks")
  UserDetailInfo                UserDetailInfo?     
  sentMessages                  Message[] @relation("SentMessages")
  receivedMessages              Message[] @relation("ReceivedMessages")

  sentFriendRequests           FriendReq[] @relation("SentFriendRequests")
  receivedFriendRequests       FriendReq[] @relation("ReceivedFriendRequests")
  myFriends                    AcceptFriend[] @relation("UserFriends")
  friendOf                     AcceptFriend[] @relation("FriendUsers")
}  

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  date        DateTime @default(now())
  priority    String
  inDetails   String 
  price       Int 
  skills      String     
  status      Boolean
  userId      Int
  assigneeId  Int?
  videoUrl    String?
  pdfUrl      String?
  assignee    User?    @relation("AssignedTasks", fields: [assigneeId], references: [id],onDelete: Cascade)
  user        User     @relation("CreatedTasks", fields: [userId], references: [id],onDelete: Cascade)
}   

model Notification {
  id          Int    @id @default(autoincrement())
  message     String
  userId      Int
  user        User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}


model UserDetailInfo {
  id             Int     @id @default(autoincrement())
  skills         String?
  about          String?  
  resume         String?
  experience     String?
  linkedinUrl    String?
  githubUrl      String?
  highestDegree  String?
  userId         Int     @unique    
  user           User    @relation(fields: [userId], references: [id],onDelete: Cascade)
}

model Message {
  id           Int     @id  @default(autoincrement())   
  content      String     
  createdAt    DateTime  @default(now())  
  senderId     Int
  receiverId   Int
  roomId       String    @default("")    
  sender       User     @relation("SentMessages", fields: [senderId], references: [id],onDelete: Cascade)
  receiver     User     @relation("ReceivedMessages", fields: [receiverId], references: [id],onDelete: Cascade)  
}
  
model FriendReq {
  id          Int  @id @default(autoincrement())
  senderId    Int
  receiverId  Int
  createdAt   DateTime @default(now())
  sender      User @relation("SentFriendRequests", fields: [senderId], references: [id],onDelete: Cascade)
  receiver    User @relation("ReceivedFriendRequests", fields: [receiverId], references: [id],onDelete: Cascade)
}


model AcceptFriend {
  id          Int  @id @default(autoincrement())
  userId      Int
  friendId    Int
  createdAt   DateTime @default(now())
  user        User @relation("UserFriends", fields: [userId], references: [id],onDelete: Cascade)
  friend      User @relation("FriendUsers", fields: [friendId], references: [id], onDelete: Cascade)
}






